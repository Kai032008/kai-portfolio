# Contact form delivery via Formspree (https://formspree.io) — no backend needed.
#
# Setup:
#   1. Create a free account at https://formspree.io
#   2. Make a new form; set the notification email to where you want enquiries sent.
#   3. Copy the form's endpoint URL (looks like https://formspree.io/f/abcwxyz).
#   4. Copy this file to ".env.local" and paste your endpoint below.
#   5. Restart `npm run dev` so Next.js picks up the new value.
#
# This value is sent from the browser, so it is public by design (safe to expose).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
